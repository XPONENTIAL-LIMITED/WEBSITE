# EmailJS credentials — copy this file to `.env` and fill in the real values.
# Dashboard: https://dashboard.emailjs.com/admin
#
# `.env` is git-ignored. Only this example file is committed.
# On Vercel, set these as Project Environment Variables instead of committing them.

# Service ID — Email Services tab
VITE_EMAILJS_SERVICE_ID=service_vhtn1qg

# Public key — Account -> General -> API Keys
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Template that delivers the enquiry to the Xponential inbox
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id

# Template that sends the automated "thank you" reply to the sender
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id

# Inbox that receives enquiries (optional — defaults to solution@xponential.co.zm)
VITE_EMAILJS_TO_EMAIL=solution@xponential.co.zm
